# Copy this file to .env and fill in real values — or just run install.bat /
# install.sh, which generates .env (with real secrets) for you automatically.
# Never commit .env to version control, and never place it under public/.

# ── Secrets — generate with: python3 scripts/gen_secrets.py ──────────
SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_PASSWORD_HASH=

ADMIN_USERNAME=admin

# ── Network ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001

# Optional: bind HTTPS directly on port 443 instead of plain HTTP on PORT
# above. Fill in both paths to enable — requires Administrator/root
# privileges to bind port 443. Leave blank to run behind a reverse proxy
# instead (the more common production setup — see INSTALL.md).
HTTPS_PORT=443
SSL_CERTFILE=
SSL_KEYFILE=

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty unless the admin panel or site is hosted on a different
# domain than this API — same-origin requests never need this.
ALLOWED_ORIGINS=

# ── Cookies ────────────────────────────────────────────────────────
# Set to true in production (HTTPS). Must be false for local http dev,
# or browsers will silently refuse to store the session cookie.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=3600

# ── Rate limits (per client IP) ───────────────────────────────────
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_APPOINTMENT=6/hour

# ── Storage locations (defaults are almost always fine) ───────────
# DATA_DIR=./data
# PUBLIC_DIR=./public

# ── Chat session cap ───────────────────────────────────────────────
# Visitor is nudged to book a call as this approaches, then hard-capped.
MAX_CHAT_EXCHANGES=15

# ── Appointment booking ────────────────────────────────────────────
APPT_TIMEZONE=Asia/Kuwait
APPT_SLOT_MINUTES=30
APPT_DAY_START_HOUR=9
APPT_DAY_END_HOUR=17
APPT_WORKDAYS=0,1,2,3,4
APPT_MAX_DAYS_AHEAD=30

# Minimum notice (hours) required to reschedule or cancel a booked
# appointment from the chat widget's "Manage Booking" tab.
APPT_MIN_NOTICE_HOURS=6

# ── Appointment emails (optional) ──────────────────────────────────
# Without these, booking/reschedule/cancel still work — confirmation
# emails are just skipped (logged as a warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
# Where admin notifications go. Falls back to the contact email set in
# the admin panel (config.json -> contact.ct-email) if left blank.
ADMIN_NOTIFY_EMAIL=

# ── Google Calendar sync (optional) ────────────────────────────────
# Create a service account, download its JSON key, then share your
# calendar with the service account's email (Settings and sharing >
# Share with specific people > "Make changes to events").
# Booking works fine locally without this — it just won't push to a
# calendar until both are set.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
