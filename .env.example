# Copy this file to .env and fill in real values — or just run install.bat /
# install.sh, which generates .env (with real secrets) for you automatically.
# Never commit .env to version control, and never place it under public/.

# ── Secrets — generate with: python3 scripts/gen_secrets.py ──────────
SECRET_KEY=
ENCRYPTION_KEY=
ADMIN_PASSWORD_HASH=

ADMIN_USERNAME=admin

# ── Network ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8001

# Optional: bind HTTPS directly on port 443 instead of plain HTTP on PORT
# above. Fill in both paths to enable — requires Administrator/root
# privileges to bind port 443. Leave blank to run behind a reverse proxy
# instead (the more common production setup — see INSTALL.md).
HTTPS_PORT=443
SSL_CERTFILE=
SSL_KEYFILE=

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty unless the admin panel or site is hosted on a different
# domain than this API — same-origin requests never need this.
ALLOWED_ORIGINS=

# ── Cookies ────────────────────────────────────────────────────────
# Set to true in production (HTTPS). Must be false for local http dev,
# or browsers will silently refuse to store the session cookie.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=3600

# ── Rate limits (per client IP) ───────────────────────────────────
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_APPOINTMENT=6/hour

# ── Database (this instance's own dedicated tenant database) ───────
# Provisioned by SiteHub's paid-tier pipeline before this app is ever
# started — never chosen by this app itself. Both required; there is no
# local-file storage fallback (see app/storage.py).
DATABASE_URL=
DB_TABLE_PREFIX=

# ── Storage locations (defaults are almost always fine) ───────────
# DATA_DIR=./data
# PUBLIC_DIR=./public

# ── Chat session cap ───────────────────────────────────────────────
# Visitor is nudged to book a call as this approaches, then hard-capped.
MAX_CHAT_EXCHANGES=15

# ── Appointment booking ────────────────────────────────────────────
APPT_TIMEZONE=Asia/Kuwait
APPT_SLOT_MINUTES=30
APPT_DAY_START_HOUR=9
APPT_DAY_END_HOUR=17
APPT_WORKDAYS=0,1,2,3,4
APPT_MAX_DAYS_AHEAD=30

# Minimum notice (hours) required to reschedule or cancel a booked
# appointment from the chat widget's "Manage Booking" tab.
APPT_MIN_NOTICE_HOURS=6

# ── Appointment emails (optional) ──────────────────────────────────
# Without these, booking/reschedule/cancel still work — confirmation
# emails are just skipped (logged as a warning).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
# Where admin notifications go. Falls back to the contact email set in
# the admin panel (config.json -> contact.ct-email) if left blank.
ADMIN_NOTIFY_EMAIL=

# ── Lead nurture (optional) ─────────────────────────────────────────
# One automatic follow-up email to a lead who shared contact details in
# the chat widget but never booked — a single nudge, sent once. Uses the
# same SMTP_* settings above; if those aren't set, this quietly does
# nothing (leads stay untouched until SMTP is configured).
NURTURE_ENABLED=true
NURTURE_DELAY_HOURS=3
NURTURE_CHECK_INTERVAL_MINUTES=15

# ── WhatsApp (optional, via Meta's WhatsApp Cloud API) ──────────────
# The click-to-chat button on the site only needs the business number
# set in the admin panel (Contact Details -> WhatsApp Number) — nothing
# below is required for that to work.
#
# Everything below is only for OUTBOUND sends (booking confirmations,
# the nurture follow-up) to a number that hasn't messaged the business
# first. That requires a Cloud API app + an approved message template —
# create both in Meta Business Manager first. Leave blank to skip
# outbound WhatsApp entirely; the click-to-chat button still works, and
# email notifications/nurture are unaffected.
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Names of already-approved templates. Each one left blank = that
# specific outbound send (booking confirmation / nurture) is skipped.
WHATSAPP_TEMPLATE_BOOKED=
WHATSAPP_TEMPLATE_NURTURE=
WHATSAPP_TEMPLATE_LANG_EN=en_US
WHATSAPP_TEMPLATE_LANG_AR=ar

# ── Google Calendar sync (optional) ────────────────────────────────
# Create a service account, download its JSON key, then share your
# calendar with the service account's email (Settings and sharing >
# Share with specific people > "Make changes to events").
# Booking works fine locally without this — it just won't push to a
# calendar until both are set.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
